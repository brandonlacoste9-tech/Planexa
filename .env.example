# Configuration de l'application Planexa

# URL de base de l'application (pour la production)
# NEXT_PUBLIC_BASE_URL=https://planexa.com

# Configuration de la base de données (pour une version de production)
# DATABASE_URL=postgresql://user:password@localhost:5432/planexa

# Configuration du service de courriel (pour une version de production)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@planexa.com
# SMTP_PASS=votre-mot-de-passe
# EMAIL_FROM=Planexa <noreply@planexa.com>

# Fuseau horaire par défaut
# TIMEZONE=America/Toronto

# Environnement
# NODE_ENV=development
